# Copy to .env; run.sh loads it. Do not commit real keys.
# No external model requests are made unless all three values are set.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# CHAT COMPLETIONS-compatible endpoint; base URL may include /v1.
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=<model name available to your account>
# MODEL_API_KEY=<your private key>

